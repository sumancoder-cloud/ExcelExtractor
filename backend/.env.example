PORT=5000
# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/excelextractor?retryWrites=true&w=majority

# Local MongoDB Connection (uncomment to use):
# MONGODB_URI=mongodb://localhost:27017/excelextractor

JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
NODE_ENV=development

# Google OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ML API Keys (Optional - for enhanced extraction)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
